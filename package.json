{
  "name": "stepfield",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node scripts/dev.mjs",
    "build": "ng build",
    "build:pages": "ng build --configuration github-pages",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "setup:media": "node scripts/setup-media.mjs",
    "serve": "node server/index.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "ffmpeg-static": "^5.3.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@playwright/test": "^1.63.0",
    "typescript": "~6.0.2"
  }
}
